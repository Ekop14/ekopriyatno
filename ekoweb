<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Front-End Developer</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Segoe UI', sans-serif;
    }

    body {
      line-height: 1.6;
      color: #333;
    }

    header {
      background: #0f172a;
      color: white;
      padding: 20px 50px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    header h1 {
      font-size: 20px;
    }

    nav a {
      color: white;
      margin-left: 20px;
      text-decoration: none;
    }

    .hero {
      height: 90vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      background: linear-gradient(to right, #2563eb, #9333ea);
      color: white;
      padding: 20px;
    }

    .hero h2 {
      font-size: 40px;
      margin-bottom: 10px;
    }

    .hero p {
      margin-bottom: 20px;
    }

    .btn {
      background: white;
      color: #2563eb;
      padding: 10px 20px;
      border-radius: 5px;
      text-decoration: none;
      font-weight: bold;
    }

    section {
      padding: 60px 50px;
    }

    .about, .skills, .portfolio, .contact {
      max-width: 1000px;
      margin: auto;
    }

    h3 {
      margin-bottom: 20px;
      font-size: 28px;
    }

    .skills ul {
      display: flex;
      gap: 15px;
      flex-wrap: wrap;
    }

    .skills li {
      list-style: none;
      background: #e2e8f0;
      padding: 10px 15px;
      border-radius: 5px;
    }

    .portfolio .card {
      background: #f1f5f9;
      padding: 20px;
      margin-bottom: 15px;
      border-radius: 8px;
    }

    footer {
      text-align: center;
      padding: 20px;
      background: #0f172a;
      color: white;
    }
  </style>
</head>
<body>

<header>
  <h1>MyPortfolio</h1>
  <nav>
    <a href="#about">Tentang</a>
    <a href="#skills">Skill</a>
    <a href="#portfolio">Portfolio</a>
    <a href="#contact">Kontak</a>
  </nav>
</header>

<section class="hero">
  <div>
    <h2>Halo, Saya Front-End Developer</h2>
    <p>Membuat tampilan web modern, responsif, dan user-friendly.</p>
    <a href="#portfolio" class="btn">Lihat Karya</a>
  </div>
</section>

<section id="about" class="about">
  <h3>Tentang Saya</h3>
  <p>
    Saya adalah seorang Front-End Developer yang fokus pada pembuatan UI/UX yang menarik dan performa tinggi menggunakan teknologi modern.
  </p>
</section>

<section id="skills" class="skills">
  <h3>Skill</h3>
  <ul>
    <li>HTML</li>
    <li>CSS</li>
    <li>JavaScript</li>
    <li>React</li>
    <li>Tailwind</li>
    <li>Git</li>
  </ul>
</section>

<section id="portfolio" class="portfolio">
  <h3>Portfolio</h3>
  <div class="card">
    <h4>Project 1</h4>
    <p>Website landing page modern dengan responsive design.</p>
  </div>
  <div class="card">
    <h4>Project 2</h4>
    <p>Aplikasi dashboard menggunakan React.</p>
  </div>
</section>

<section id="contact" class="contact">
  <h3>Kontak</h3>
  <p>Email: emailkamu@gmail.com</p>
  <p>LinkedIn: linkedin.com/in/username</p>
</section>

<footer>
  <p>© 2026 Front-End Developer</p>
</footer>

</body>
</html>